{
  "name": "micodent-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:coverage": "c8 node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:e2e:open": "node scripts/test-e2e.mjs --open"
  },
  "dependencies": {
    "axios": "1.18.0",
    "lucide-react": "1.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hot-toast": "2.6.0",
    "react-router-dom": "7.15.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-transform-react-jsx": "7.28.6",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "autoprefixer": "10.5.0",
    "c8": "12.0.0",
    "cypress": "16.1.1",
    "eslint": "10.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.14",
    "tailwindcss": "3.4.19",
    "vite": "8.0.11"
  },
  "c8": {
    "all": true,
    "src": [
      "src"
    ],
    "include": [
      "src/**/*.js",
      "src/**/*.jsx"
    ],
    "exclude": [
      "src/main.jsx"
    ],
    "extension": [
      ".js",
      ".jsx"
    ],
    "reporter": [
      "text-summary",
      "lcovonly",
      "json-summary"
    ],
    "reporterOptions": {
      "lcovonly": {
        "projectRoot": ".."
      }
    },
    "reports-dir": "coverage",
    "check-coverage": false
  }
}
