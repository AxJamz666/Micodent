{
  "name": "micodent-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST - Clínica Micodent",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "migrate:s1a": "node scripts/migrate-s1a.js",
    "security:check": "node scripts/check-secrets.js",
    "security:history": "node scripts/check-secrets.js --history",
    "prepack": "node scripts/check-secrets.js --history"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "multer": "2.1.1",
    "mysql2": "3.22.5",
    "rate-limiter-flexible": "11.2.0"
  },
  "devDependencies": {
    "nodemon": "3.1.14"
  }
}
